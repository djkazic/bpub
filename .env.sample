# Indexer source: "esplora" (no local node needed; round-robins ESPLORA_URLS) or "rpc"
# If unset, auto-selects "rpc" when BITCOIN_RPC_USER is set, else "esplora".
INDEXER_SOURCE=esplora
ESPLORA_URLS=https://mempool.kilombino.com,https://mempool.guide
ESPLORA_REQUEST_DELAY=0.25

# Optional: Bitcoin / BLAKE2b Knots RPC (only needed if INDEXER_SOURCE=rpc or using RPC hot wallet)
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=
BITCOIN_RPC_HOST=host.docker.internal
BITCOIN_RPC_PORT=8332
GALLERY_DIR=gallery
# BLAKE2b fork height (961640) — no need to index prior blocks
START_HEIGHT=961640
POLL_INTERVAL=30

# Gallery web server & broadcaster (point cloudflared at http://<host>:8888)
BROADCAST_URL=https://mempool.kilombino.com/api/tx
EXPLORER_BASE_URL=https://mempool.kilombino.com
BPUB_HOST=0.0.0.0
BPUB_PORT=8888
# Set to 1 behind cloudflared so CF-Connecting-IP / X-Forwarded-For is used for rate limits
BPUB_TRUST_PROXY=1
# Comma-separated CORS origins (empty = same-origin only)
BPUB_CORS_ORIGINS=

# Optional: Custodial Lightning (LND) -> padv3 inscription service
# Leave LND_REST_URL empty to run gallery + self-custody PSBT studio only.
LND_REST_URL=
# Prefer least-privilege invoice.macaroon (never admin.macaroon)
LND_MACAROON_PATH=
LND_MACAROON_HEX=
LND_TLS_CERT_PATH=
LND_TLS_VERIFY=1

# Order funding & signing controls (used when LND_REST_URL is set)
# "unified" = BLAKE2b SIGHASH_ALL|SIGHASH_UNIFIED (0x21); "btc" = standard BIP143 (0x01)
ORDER_SIGN_MODE=unified
# Node-less hot wallet: dedicated P2WPKH WIF funded with BTCB2 coins (only used by order-worker).
# Leave empty to use the Knots RPC wallet (ORDER_RPC_WALLET) instead.
ORDER_HOT_WIF=
ORDER_RPC_WALLET=
ORDER_FEERATE_SAT_VB=2
ORDER_PRICE_BASE_SATS=500
ORDER_PRICE_PER_KB_SATS=100
ORDER_ONCHAIN_TO_LN_RATIO=0.0
ORDER_MIN_LN_SATS=500
ORDER_MAX_LN_SATS=500000
ORDER_INVOICE_EXPIRY_SEC=900
ORDER_MAX_PENDING_PER_IP=3
ORDER_MAX_TOTAL_PENDING=50
ORDER_DAILY_BUDGET_SATS=5000000
ORDER_POLL_INTERVAL=5
# Max upload size for Instant Inscribe (files >190 KiB automatically use BPUB multipart v1)
BPUB_MAX_ORDER_UPLOAD_BYTES=1048576
